#!/usr/bin/env bash
# mdcc launcher shipped with the Claude Code plugin.
#
# While the plugin is enabled, this directory is on PATH, so both skill-driven
# agents and humans can invoke `mdcc` by bare name — with no global install and
# a version pinned to the plugin (below). Updates arrive via `/plugin update`.
set -euo pipefail

# Pin the exact mdcc release. Bump this together with the plugin version.
MDCC_REF="v0.1.0"
MDCC_SPEC="git+https://github.com/danil09234/mdcc@${MDCC_REF}"

# macOS: WeasyPrint's native deps (pango/cairo/gobject) live under Homebrew and
# are not on the default loader path. Set it here so every invocation works
# without the caller having to remember it.
if [[ "$(uname)" == "Darwin" ]]; then
  export DYLD_FALLBACK_LIBRARY_PATH="/opt/homebrew/lib:${DYLD_FALLBACK_LIBRARY_PATH:-}"
fi

if ! command -v uvx >/dev/null 2>&1; then
  echo "mdcc: 'uv' is required but not found. Install it (https://docs.astral.sh/uv/) or run /mdcc-setup." >&2
  exit 127
fi

# uv resolves + builds once per pinned ref, then serves from cache.
exec uvx --from "${MDCC_SPEC}" mdcc "$@"
